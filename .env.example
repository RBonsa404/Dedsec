# DEDSEC
PROJECT_NAME=dedsec

# Database
DATABASE_URL=postgresql://dedsec:dedsec_secret@localhost:5432/dedsec_db
POSTGRES_USER=dedsec
POSTGRES_PASSWORD=dedsec_secret
POSTGRES_DB=dedsec_db

# JWT
JWT_SECRET=dedsec-jwt-secret-change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dedsec-refresh-secret-change-me-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Backend
BACKEND_PORT=4000
BACKEND_URL=http://localhost:4000

# Frontend
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=dedsec_minio
MINIO_ROOT_PASSWORD=dedsec_minio_secret
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_BUCKET=dedsec-files
MINIO_USE_SSL=false

# Email (Nodemailer - dev mode with Ethereal)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@dedsec.io
